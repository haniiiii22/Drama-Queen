{
  "name": "drama-queen",
  "version": "1.0.0",
  "private": true,
  "description": "Drama Queen \u2014 a personal, non-commercial movie and TV series archive.",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/verify-dist.mjs",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.js\"",
    "contrast": "node scripts/contrast.mjs",
    "audit": "npm audit --omit=dev && npm audit",
    "catalog:plan": "node scripts/refresh-catalog.mjs --plan",
    "catalog:refresh": "node scripts/refresh-catalog.mjs",
    "catalog:validate": "node scripts/validate-catalog.mjs public/data/catalog.json --source public/Movies.txt"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.2.0",
    "jsdom": "^30.0.0",
    "vite": "^8.0.0",
    "yaml": "^2.9.1"
  }
}
